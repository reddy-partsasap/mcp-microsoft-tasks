{
  "name": "mcp-microsoft-tasks",
  "version": "1.0.0",
  "description": "MCP server for reading Microsoft 365 tasks (Planner, To-Do, flagged emails) via Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-microsoft-tasks": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
